# Gaeliza v2 uses dedicated variable names so a local legacy .env cannot
# accidentally point the rewritten application at the old production project.

VITE_GAELIZA_V2_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_GAELIZA_V2_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Compatibility fallback only if the target project still uses a legacy anon key:
# VITE_GAELIZA_V2_SUPABASE_ANON_KEY=your_legacy_anon_key

# Never put a service_role or other secret key in Vite environment variables.
